#!/bin/bash
# 【已废弃】push-to-server 方式的钩子，保留作为参考
# 现在用 GitHub + git pull 方式部署，不再需要这个钩子
set -e
WORK_TREE=/var/www/amara
GIT_DIR=/srv/git/amara.git
while read oldrev newrev ref; do
  [ "$ref" = "refs/heads/main" ] || continue
  git --work-tree="$WORK_TREE" --git-dir="$GIT_DIR" checkout -f main
  echo ">>> 已部署 $(git --git-dir="$GIT_DIR" log -1 --format='%h %s' main) 到 $WORK_TREE"
  if [ -f "$WORK_TREE/deploy/nginx/amara.conf" ] && ! cmp -s "$WORK_TREE/deploy/nginx/amara.conf" /etc/nginx/conf.d/amara.conf; then
    echo ">>> Nginx 配置有变化，请在服务器执行：sudo cp $WORK_TREE/deploy/nginx/amara.conf /etc/nginx/conf.d/ && sudo nginx -t && sudo systemctl reload nginx"
  fi
done
